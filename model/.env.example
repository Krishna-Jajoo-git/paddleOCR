# Backend environment variables
# Rotate this key and set your Google Gemini API key
GEMINI_API_KEY=your_gemini_api_key_here

# Secret API token for authentication between Next.js server and Python service (X-API-Key)
API_TOKEN=your_secure_random_api_token_here

# Optional Database URL (defaults to sqlite:///rx_local.db if omitted)
# For production PostgreSQL: postgresql://user:password@localhost:5432/prescription_db
DATABASE_URL=sqlite:///rx_local.db

# Device for PaddleOCR-VL ("cpu" or "cuda")
PADDLEOCR_DEVICE=cpu

# Server port and host
PORT=8000
HOST=127.0.0.1

# Allowed frontend origin for CORS
FRONTEND_ORIGIN=http://localhost:3000
